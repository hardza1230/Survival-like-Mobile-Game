      "loop": false
    },
    {
      "key": "vo_b02_fight_3",
      "speaker": "boss_c2",
      "text": "Clogged forever!",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b02_fight_3.mp3",
