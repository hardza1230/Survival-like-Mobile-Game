      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b02_slip_2",
      "speaker": "boss_c2",
      "text": "Please, let the water flow.",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b02_slip_2.mp3",
      "bytes": 28046,
      "sha256": "692ab41c0808e87209e0443d99327c7509f0ef66a151e6ad27aa5fa4dcce9537",
      "duration_ms": 1694,
      "peakDbtp": -7.3,
      "leadingSilenceMs": 2.99,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b03_slip_1",
      "speaker": "boss_c2",
      "text": "Someone is waiting for a warm meal.",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b03_slip_1.mp3",
      "bytes": 39749,
      "sha256": "e31ac94d4cb4e4b68f668e7ec93a5541ed26796bd060a567e6d6cb99b70af6bb",
      "duration_ms": 2415,
      "peakDbtp": -8.5,
      "leadingSilenceMs": 2.93,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b03_slip_2",
      "speaker": "boss_c2",
      "text": "I only wanted to feed them.",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b03_slip_2.mp3",
      "bytes": 23030,
      "sha256": "60794263993481b1153692e7878db7e1dfbb9718e1575c29c3b2d52635b22366",
      "duration_ms": 1359,
      "peakDbtp": -4.1,
      "leadingSilenceMs": 4.38,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b04_slip_1",
      "speaker": "boss_c2",
      "text": "Were they cold all this time?",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b04_slip_1.mp3",
      "bytes": 28046,
      "sha256": "8308da90596086dffa81f299f93b6488df9ccf233a4a5930619f35bbd2d9a9eb",
      "duration_ms": 1697,
      "peakDbtp": -4.8,
      "leadingSilenceMs": 4.81,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b04_slip_2",
      "speaker": "boss_c2",
      "text": "I wanted to keep them safe.",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b04_slip_2.mp3",
      "bytes": 21776,
      "sha256": "4b29366de0322952bd9ee47bfa949543bfeb3fa57f5f39c8dbf0ccef18f6a4c5",
      "duration_ms": 1288,
      "peakDbtp": -4.3,
      "leadingSilenceMs": 2.38,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b06_slip_1",
      "speaker": "boss_c3",
      "text": "Mother… can you hear me?",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b06_slip_1.mp3",
      "bytes": 19269,
      "sha256": "0e29b8eddacb3b01e29c1317d045b681634a5a1b274b7bd4739dd54385da9e21",
      "duration_ms": 1149,
      "peakDbtp": -10.5,
      "leadingSilenceMs": 5.33,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b06_slip_2",
      "speaker": "boss_c3",
      "text": "I wanted a garden of my own.",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b06_slip_2.mp3",
      "bytes": 25538,
      "sha256": "a5ff61417542a2b368e3c1ba1f3f1ed76d2393eb8e71d5d65d4f7a52199321c1",
      "duration_ms": 1532,
      "peakDbtp": -3.0,
      "leadingSilenceMs": 12.49,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b08_slip_1",
      "speaker": "boss_c3",
      "text": "My hive… did they have enough?",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b08_slip_1.mp3",
      "bytes": 34315,
      "sha256": "f9e49866ab39a2dade4a16b3a37c52de59599762eeb14a6a669d545d5fb5bd1a",
      "duration_ms": 2068,
      "peakDbtp": -4.9,
      "leadingSilenceMs": 4.94,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b08_slip_2",
      "speaker": "boss_c3",
      "text": "That honey tastes wrong.",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b08_slip_2.mp3",
      "bytes": 29718,
      "sha256": "31854bbb4b71de044f2284897771e869b4588edda294abe9f6dddf2aaf27d4e7",
      "duration_ms": 1785,
      "peakDbtp": -4.7,
      "leadingSilenceMs": 1.88,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b10_slip_1",
      "speaker": "boss_c3",
      "text": "The garden… it is so heavy.",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b10_slip_1.mp3",
      "bytes": 39749,
      "sha256": "65f952df27b1552af0fcb08be6aaff972c54fe6965883a1261235742f1bb5d0b",
      "duration_ms": 2409,
      "peakDbtp": -5.7,
      "leadingSilenceMs": 13.15,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b10_slip_2",
      "speaker": "boss_c3",
      "text": "There is someone beneath the roots.",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b10_slip_2.mp3",
      "bytes": 26374,
      "sha256": "698408ee5059d8703c5a74a0914e33d05917845d3a51b3788845d51eb7970128",
      "duration_ms": 1578,
      "peakDbtp": -5.4,
      "leadingSilenceMs": 4.1,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b11_slip_1",
      "speaker": "boss_c2",
      "text": "These fields need time to rest.",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b11_slip_1.mp3",
      "bytes": 32643,
      "sha256": "7d887431e84b720f818b5c2571a201794b03a9e8447bc6d675909aaefe9d544b",
      "duration_ms": 1983,
      "peakDbtp": -2.4,
      "leadingSilenceMs": 1.41,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b11_slip_2",
      "speaker": "boss_c2",
      "text": "Did anything survive the harvest?",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b11_slip_2.mp3",
      "bytes": 22612,
      "sha256": "5eb3574a53e4dd7cbbe6c3f8ed7963983273037a16c6ca533ecbc9cdb0db705c",
      "duration_ms": 1353,
      "peakDbtp": -9.6,
      "leadingSilenceMs": 9.21,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b13_slip_1",
      "speaker": "boss_c2",
      "text": "Can they grow beyond the glass?",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b13_slip_1.mp3",
      "bytes": 43092,
      "sha256": "cc53f1a3ac33e6912d7a8e10597b5c26bcfc0a9aaf8a9113669e1d5128d61226",
      "duration_ms": 2632,
      "peakDbtp": -4.7,
      "leadingSilenceMs": 4.81,
      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b13_slip_2",
      "speaker": "boss_c2",
      "text": "I only wanted to keep them safe.",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b13_slip_2.mp3",
      "bytes": 30554,
      "sha256": "03fb1b0deabd0e98751c5cedf6c5c017f83b331fea792b1d5fc0d04268be249b",
