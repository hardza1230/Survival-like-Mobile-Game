      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b14_slip_2",
      "speaker": "boss_c2",
      "text": "What good is a seed that never grows?",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b14_slip_2.mp3",
      "bytes": 29718,
