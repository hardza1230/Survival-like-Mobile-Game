      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b13_fight_3",
      "speaker": "boss_c2",
      "text": "Look, but do not touch!",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b13_fight_3.mp3",
