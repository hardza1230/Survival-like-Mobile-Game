      "loop": false
    },
    {
      "key": "vo_b10_fight_3",
      "speaker": "boss_c3",
      "text": "My roots run deep!",
      "voice_id": "akO64UeBz1XW95nNmuVW",
      "file": "vo_b10_fight_3.mp3",
      "bytes": 20941,
      "sha256": "bb89efd1eb0f8efe35e47400a55b979074f39bc90e0803031cf7a9220e975b35",
