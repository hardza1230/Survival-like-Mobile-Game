      "sampleRate": 44100,
      "channels": 1,
      "loop": false
    },
    {
      "key": "vo_b14_slip_1",
      "speaker": "boss_c2",
      "text": "Seeds need soil, don’t they?",
      "voice_id": "1fQG71AjI2V2lnywmnx0",
      "file": "vo_b14_slip_1.mp3",
      "bytes": 27210,
      "sha256": "e5a0af40dc0432c396293f40a4f43bd03b334a5fdf76162991239abd943950da",
